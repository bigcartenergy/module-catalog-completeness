<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="BigCartEnergy_Core::bce" title="Big Cart Energy" translate="title" sortOrder="200">
                    <resource id="BigCartEnergy_CatalogCompleteness::completeness" title="PIM: Catalog Completeness" translate="title" sortOrder="10">
                        <resource id="BigCartEnergy_CatalogCompleteness::dashboard" title="Dashboard" translate="title" sortOrder="10"/>
                        <resource id="BigCartEnergy_CatalogCompleteness::rulesets" title="Rule sets" translate="title" sortOrder="20">
                            <resource id="BigCartEnergy_CatalogCompleteness::rulesets_edit" title="Edit rule sets" translate="title" sortOrder="10"/>
                        </resource>
                        <resource id="BigCartEnergy_CatalogCompleteness::recalculate" title="Recalculate scores" translate="title" sortOrder="30"/>
                        <resource id="BigCartEnergy_CatalogCompleteness::export" title="Export CSV" translate="title" sortOrder="40"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="BigCartEnergy_CatalogCompleteness::config" title="PIM: Catalog Completeness Section" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
