<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <extension_attributes for="Magento\Catalog\Api\Data\ProductInterface">
        <attribute code="bce_completeness_score" type="int">
            <resources>
                <resource ref="BigCartEnergy_CatalogCompleteness::dashboard"/>
            </resources>
        </attribute>
        <attribute code="bce_completeness_missing" type="string[]">
            <resources>
                <resource ref="BigCartEnergy_CatalogCompleteness::dashboard"/>
            </resources>
        </attribute>
        <attribute code="bce_completeness_state" type="string">
            <resources>
                <resource ref="BigCartEnergy_CatalogCompleteness::dashboard"/>
            </resources>
        </attribute>
    </extension_attributes>
</config>
